# Másold .env-be, és a LOCAL_DB_PASSWORD helyére írd a helyi PostgreSQL jelszót.
# A .env nem kerül verziókövetésbe.
DATABASE_URL=postgres://football_v2:LOCAL_DB_PASSWORD@127.0.0.1:5432/football_v2_dev
TEST_DATABASE_URL=postgres://football_v2:LOCAL_DB_PASSWORD@127.0.0.1:5432/football_v2_test
APP_TIMEZONE=Europe/Budapest
DATA_DIR=./data
BIND_ADDR=127.0.0.1:0
# Helyi AI (opcionális; a defaultok a lokális Magnitude/SearXNG címekre mutatnak).
